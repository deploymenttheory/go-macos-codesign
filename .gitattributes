# .gitattributes snippet to force users to use same line endings for project.
# 
# Handle line endings automatically for files detected as text
# and leave all files detected as binary untouched.
* text=auto

*.json text eol=lf
*.go text eol=lf
*.py text eol=lf
*.yml text eol=lf
# This XML is embedded verbatim in the Apple reference signatures.
testdata/entitlements.plist text eol=lf
testdata/macho/* -text
testdata/macho/*.json text eol=lf
testdata/certificate-layout/* -text
testdata/certificate-layout/*.json text eol=lf
testdata/certificate-layout/*.md text eol=lf
third_party/** -text
NOTICE text eol=lf
# Retain upstream dependency and license bytes exactly, including whitespace.
third_party/** -whitespace
